# Copy this file to a local .env file and fill in your own credentials.
# Never commit real broker, Telegram or account credentials.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

WATCH_CHANNELS=
TRADE_CHANNELS=
SIGNAL_RISK_PCT_PER_LEG=1.0
# true: identical setups from different chat_id values may trade independently;
# repeats inside one Telegram group are still deduplicated.
SIGNAL_ALLOW_CROSS_CHANNEL_DUPLICATES=false
DATA_DIR=data_local
